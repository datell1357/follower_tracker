    android:orientation="vertical" android:padding="18dp" android:background="@drawable/widget_background">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/app_name" android:textColor="#375ED8" android:textSize="16sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:text="@string/widget_loading" android:textColor="#566176" android:textSize="12sp" />
</LinearLayout>
